# TBC callback command: set_language_ar
# Stores Arabic and replaces the language-selection message with required membership.

User.saveData("language", "ar")
bot.answerCallbackQuery(callback_query_id=message.id, text="تم اختيار العربية")

try:
    bot.deleteMessage(
        chat_id=message.message.chat.id,
        message_id=message.message.message_id
    )
except Exception:
    pass

bot.runCommand("show_join_required")
