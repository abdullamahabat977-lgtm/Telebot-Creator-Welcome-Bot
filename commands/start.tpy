# TBC command: /start
# Captures a referral candidate only once and saves the invited user's display name
# so the inviter can be told who joined through their referral link.

language = User.getData("language")

if params and not User.getData("referrer_candidate") and not User.getData("membership_completed"):
    candidate = str(params).strip()
    if candidate.isdigit() and candidate != str(u):
        User.saveData("referrer_candidate", candidate)
        try:
            invited_name = str(message.from_user.first_name)
            if invited_name and invited_name != "None":
                User.saveData("referral_invitee_name", invited_name)
        except Exception:
            User.saveData("referral_invitee_name", "New user")

if language in ["ps", "fa", "ar", "en"]:
    if User.getData("membership_completed"):
        bot.runCommand("show_main_menu")
    else:
        bot.runCommand("show_join_required")
else:
    bot.sendMessage(
        "🌐 مهرباني وکړئ خپله ژبه انتخاب کړئ:\n"
        "🌐 لطفاً زبان خود را انتخاب کنید:\n"
        "🌐 الرجاء اختيار لغتك:\n"
        "🌐 Please choose your language:",
        reply_markup={
            "inline_keyboard": [
                [
                    {"text": "🇦🇫 پښتو", "callback_data": "set_language_ps", "style": "primary"},
                    {"text": "🇮🇷 فارسی", "callback_data": "set_language_fa", "style": "success"}
                ],
                [
                    {"text": "🇸🇦 العربية", "callback_data": "set_language_ar", "style": "danger"},
                    {"text": "🇬🇧 English", "callback_data": "set_language_en", "style": "primary"}
                ]
            ]
        }
    )
