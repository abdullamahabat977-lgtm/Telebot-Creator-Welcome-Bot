# TBC callback command: set_language_fa
# Stores Persian and replaces the language-selection message with required membership.

User.saveData("language", "fa")
bot.answerCallbackQuery(callback_query_id=message.id, text="زبان فارسی انتخاب شد")

try:
    bot.deleteMessage(
        chat_id=message.message.chat.id,
        message_id=message.message.message_id
    )
except Exception:
    pass

bot.runCommand("show_join_required")
