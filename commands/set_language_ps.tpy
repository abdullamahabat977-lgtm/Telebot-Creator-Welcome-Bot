# TBC callback command: set_language_ps
# Stores Pashto and replaces the language-selection message with required membership.

User.saveData("language", "ps")
bot.answerCallbackQuery(callback_query_id=message.id, text="ژبه پښتو وټاکل شوه")

try:
    bot.deleteMessage(
        chat_id=message.message.chat.id,
        message_id=message.message.message_id
    )
except Exception:
    pass

bot.runCommand("show_join_required")
