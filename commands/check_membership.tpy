# TBC callback command: check_membership
# Answer callback immediately, then remove the old join prompt regardless of result.
# Never answer the same callback query a second time.

try:
    bot.answerCallbackQuery(callback_query_id=message.id, text="🔎")
except Exception:
    pass

try:
    bot.deleteMessage(
        chat_id=message.message.chat.id,
        message_id=message.message.message_id
    )
except Exception:
    pass

required_chats = Bot.getData("required_chats")
if not required_chats:
    required_chats = [
        {"id": -1003032328044, "link": "https://t.me/Links_and_Ads_Group", "title": "Links and Ads Group", "type": "group"},
        {"id": -1003758811564, "link": "https://t.me/AbdullahAghaDigital", "title": "Abdullah Agha Digital", "type": "channel"}
    ]
    Bot.saveData("required_chats", required_chats)

language = User.getData("language")
if language == "fa":
    check_error_text = "⚠️ بررسی عضویت ممکن نیست. لطفاً دسترسی ربات و مدیر بودن آن در همه گروه‌ها و کانال‌ها را بررسی کنید."
elif language == "ar":
    check_error_text = "⚠️ تعذّر التحقق من العضوية. تحقق من صلاحيات البوت ومن كونه مشرفًا في جميع المجموعات والقنوات."
elif language == "en":
    check_error_text = "⚠️ Membership could not be checked. Make sure the bot has access and is an administrator in every required group and channel."
else:
    check_error_text = "⚠️ د ګډون تایید ممکن نه شو. د بوټ لاسرسی او په ټولو اړینو ګروپونو او چینلونو کې د اډمین اجازه وګوره."

try:
    joined_all = True
    for chat in required_chats:
        member = bot.getChatMember(chat_id=int(chat["id"]), user_id=u)
        status = member.status
        joined_this_chat = (
            status in ["creator", "administrator", "member"]
            or (status == "restricted" and getattr(member, "is_member", False))
        )
        if not joined_this_chat:
            joined_all = False
except Exception:
    bot.sendMessage(check_error_text)
else:
    if not joined_all:
        # Old prompt was already deleted; show a fresh, localized prompt.
        bot.runCommand("show_join_required")
    else:
        bot.runCommand("complete_membership")
