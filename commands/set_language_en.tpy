# TBC callback command: set_language_en
# Stores English and replaces the language-selection message with required membership.

User.saveData("language", "en")
bot.answerCallbackQuery(callback_query_id=message.id, text="English selected")

try:
    bot.deleteMessage(
        chat_id=message.message.chat.id,
        message_id=message.message.message_id
    )
except Exception:
    pass

bot.runCommand("show_join_required")
